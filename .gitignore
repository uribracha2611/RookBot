# 1. Ignore everything by default
*

# 2. Allow top-level configuration files
!.gitignore
!Cargo.toml
!Cargo.lock
!README.md

# 3. Allow the src directory itself (but not its contents yet)
!src/

# 4. Ignore everything inside src by default
src/*

# 5. Specifically allow your files and the bin directory
!src/SEE.txt
!src/constants.rs
!src/lmr_table.bin
!src/bin/
# 6. Open the path layer by layer
!src/engine/
!src/engine/search/
!src/engine/search/nnue/

# Now Git can see everything inside nnue
!src/engine/search/nnue/**
# 6. Allow everything inside the bin directory
!src/bin/**/*
!src/engine/search/nnue/**/*